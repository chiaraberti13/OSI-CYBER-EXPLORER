{
  "name": "osi-cyber-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bilingual, interactive lab to study the OSI model, packet encapsulation and layer-by-layer network security.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:network": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "analyze:bundle": "vite build --mode analyze",
    "verify": "npm run verify:lockfile && npm run verify:release && npm run verify:deployment-security && npm run verify:repository-posture && npm run verify:documentation-targets && npm run verify:offensive-content && npm run verify:technical-content && npm run verify:design-system && npm run verify:accessibility-release && npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run verify:performance",
    "verify:performance": "node --test scripts/performance-budget.test.mjs && size-limit && node scripts/performance-budget.mjs",
    "verify:release": "node --test scripts/release-metadata.test.mjs",
    "verify:deployment-security": "node --test scripts/deployment-security.test.mjs",
    "verify:repository-posture": "node --test scripts/scorecard-report.test.mjs",
    "verify:documentation-targets": "node --test scripts/documentation-targets.test.mjs && node scripts/documentation-targets.mjs",
    "verify:offensive-content": "node --test scripts/offensive-content-review.test.mjs && node scripts/offensive-content-review.mjs",
    "verify:technical-content": "node --test scripts/technical-content-review.test.mjs && node scripts/technical-content-review.mjs",
    "verify:design-system": "node --test scripts/design-system.test.mjs",
    "verify:accessibility-release": "node --test scripts/accessibility-release.test.mjs",
    "verify:lockfile:bootstrap": "node --test scripts/verify-lockfile.test.mjs && node scripts/verify-lockfile.mjs",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity --validate-package-names --empty-hostname false",
    "verify:lockfile": "npm run verify:lockfile:bootstrap && npm run lint:lockfile",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high",
    "audit:signatures:runtime": "npm audit signatures --omit=dev",
    "audit:signatures:full": "npm audit signatures"
  },
  "dependencies": {
    "lucide-react": "^1.51.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@size-limit/file": "14.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "lockfile-lint": "5.0.1",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "7.1.1",
    "size-limit": "14.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.4"
  },
  "size-limit": [
    {
      "name": "Initial JavaScript (gzip)",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "125 kB"
    },
    {
      "name": "Largest route chunk: Ports Explorer (gzip)",
      "path": "dist/assets/PortsExplorer-*.js",
      "gzip": true,
      "limit": "55 kB"
    }
  ]
}
